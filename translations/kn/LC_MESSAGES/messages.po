#: utils/validators.py:38
#, python-format
msgid "Missing required field(s): %(fields)s."
msgstr "ಅಗತ್ಯ ಕ್ಷೇತ್ರ(ಗಳು) ಕಾಣೆಯಾಗಿವೆ: %(fields)s."

#: utils/validators.py:45
#, python-format
msgid "%(field)s must be at least %(min_length)s character(s)."
msgstr "%(field)s ಕನಿಷ್ಠ %(min_length)s ಅಕ್ಷರ(ಗಳು) ಆಗಿರಬೇಕು."

#: utils/validators.py:50
#, python-format
msgid "%(field)s must be %(max_length)s characters or fewer."
msgstr "%(field)s %(max_length)s ಅಕ್ಷರಗಳು ಅಥವಾ ಅದಕ್ಕಿಂತ ಕಡಿಮೆ ಆಗಿರಬೇಕು."

#: utils/validators.py:64
msgid "File has no extension."
msgstr "ಫೈಲ್‌ಗೆ ಯಾವುದೇ ವಿಸ್ತರಣೆ ಇಲ್ಲ."

#: utils/validators.py:68
#, python-format
msgid "Unsupported file type '.%(ext)s'. Allowed: %(allowed)s."
msgstr "ಬೆಂಬಲಿಸದ ಫೈಲ್ ಪ್ರಕಾರ '.%(ext)s'. ಅನುಮತಿಸಲಾದ: %(allowed)s."

#: utils/validators.py:73
#, python-format
msgid "File is too large (max %(max_mb)sMB)."
msgstr "ಫೈಲ್ ತುಂಬಾ ದೊಡ್ಡದಾಗಿದೆ (ಗರಿಷ್ಠ %(max_mb)sMB)."

#: utils/validators.py:97
msgid ""
"Username must be 3-32 characters and contain only letters, numbers, dots, "
"underscores, or hyphens."
msgstr ""
"ಬಳಕೆದಾರಹೆಸರು 3-32 ಅಕ್ಷರಗಳಾಗಿರಬೇಕು ಮತ್ತು ಕೇವಲ ಅಕ್ಷರಗಳು, ಸಂಖ್ಯೆಗಳು, ಚುಕ್ಕೆಗಳು,"
