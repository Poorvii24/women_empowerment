# ISIS Career Intelligence Platform — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Core ---
# development | testing | production. Controls cookie security defaults,
# debug mode, and whether a missing secret key is fatal. See config.py.
ISIS_ENV=development

# Required in production; auto-generated (with a warning) in development.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ISIS_SECRET_KEY=

# --- Database ---
# Path to the SQLite file. Defaults to isis_portfolio.db next to db.py if unset.
ISIS_DB_PATH=

# --- Third-party APIs ---
# Optional. Without this, activity analysis and the AI Copilot both fall
# back to local, fully offline logic (see nlp/embedding_engine.py and
# services/ai_copilot.py's local fallback responder).
GEMINI_API_KEY=

# --- Session / cookies ---
# Set to "true" once serving over HTTPS. Keep "false" for local HTTP dev.
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT_MINUTES=60
REMEMBER_COOKIE_DAYS=14

# --- Logging ---
LOG_LEVEL=INFO
ISIS_LOG_DIR=logs
ISIS_LOG_TO_FILE=true

# --- Server (used by `python app.py`; not used by gunicorn/Docker) ---
ISIS_HOST=127.0.0.1
ISIS_PORT=5000
FLASK_DEBUG=false

# --- Docker / docker-compose only ---
GUNICORN_WORKERS=2

# --- Rate limiting (Flask-Limiter) ---
# "memory://" is fine for a single instance. Use a shared Redis URL
# (e.g. redis://redis:6379/0) if you ever run more than one worker/replica,
# otherwise each process enforces its own separate limit.
RATELIMIT_STORAGE_URI=memory://
